# Database
DATABASE_URL=postgresql://latex_ide:latex_ide_dev@localhost:5432/latex_ide

# Redis
REDIS_URL=redis://localhost:6379

# Clerk Auth (sign up at https://clerk.com)
# Leave blank for dev bypass (no auth required)
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Collaboration server
NEXT_PUBLIC_COLLAB_URL=ws://localhost:3030
COLLAB_PORT=3030

# LLM APIs
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Web search (sign up at https://tavily.com)
TAVILY_API_KEY=

# Cloudflare R2 / S3-compatible storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=latex-ide
R2_ENDPOINT=

# API
PORT=3001
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000
# NODE_ENV=development  # Set to 'production' in production — auth bypass is blocked in production

# Frontend → API connection (used by Next.js client-side fetch)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Compile worker
COMPILE_OUTPUT_DIR=./compile-output
COMPILE_TIMEOUT_MS=60000
TEXLIVE_IMAGE=latex-ide-texlive:2025
