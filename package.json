{
  "name": "latex-ide",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "docker:build:texlive": "docker build -t latex-ide-texlive:2025 -f docker/texlive.Dockerfile docker"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prettier": "^3.8.2",
    "turbo": "^2.9.6",
    "typescript": "^5.7.0"
  }
}
